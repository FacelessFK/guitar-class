{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  // drizzle.config.ts عمداً بیرون است — خود drizzle-kit آن را کامپایل
  // می‌کند و داخل کردنش با rootDir برابر src تداخل دارد
  "include": ["src/**/*.ts"]
}
