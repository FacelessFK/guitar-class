{
  "name": "@music/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register --watch src/worker.ts",
    "start:worker": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/worker.ts",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/db/seed.ts",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "verify:storage": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/media/verify-storage.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@music/shared": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "bullmq": "^6.0.11",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^3.0.5"
  }
}
