# این فایل را به .env کپی کنید. مقادیر پیش‌فرض با docker-compose.yml هماهنگ‌اند.

# ---- دیتابیس ----
DATABASE_URL="postgresql://music:music_dev_password@localhost:5433/music"

# ---- ردیس ----
REDIS_URL="redis://localhost:6380"

# ---- تست ----
# تست‌های یکپارچگی بین هر تست TRUNCATE و FLUSHDB می‌کنند، پس هرگز روی
# دیتابیس توسعه اجرا نمی‌شوند. اگر این دو خالی بمانند، خودکار از روی
# مقادیر بالا ساخته می‌شوند: دیتابیس «music_test» و ردیس شماره‌ی ۱.
# دیتابیس تست در اولین اجرا خودش ساخته و مایگریت می‌شود.
# پسوند «_test» اجباری است — تست‌ها روی هر نام دیگری بالا نمی‌آیند.
TEST_DATABASE_URL=""
TEST_REDIS_URL=""

# ---- API ----
API_PORT=4000
NODE_ENV=development

# ---- منطقه‌ی زمانی ----
# همه‌ی زمان‌ها در دیتابیس UTC هستند؛ این فقط برای لایه‌ی نمایش و محاسبه‌ی اسلات است.
APP_TIMEZONE="Asia/Tehran"

# ---- جیتسی ----
# نمونه‌ی اختصاصی پلتفرم، جدا از جیتسیِ جلسات داخلی تیم
# (jitsi.hyggemode.com که ورود ناشناس دارد و به این پروژه ربطی ندارد).
# جداسازی فیزیکی است: prosody جدا، سکرت جدا، شبکه‌ی داکر جدا.
# روی سرور در /home/fardin/music-platform/jitsi زندگی می‌کند.
JITSI_DOMAIN="class.hyggemode.com"
# باید با JWT_ACCEPTED_ISSUERS روی سرور یکی باشد
JITSI_APP_ID="music-platform"
# باید با JWT_ACCEPTED_AUDIENCES روی سرور یکی باشد
JITSI_AUDIENCE="jitsi"
# ادعای `sub` توکن — دامنه‌ی XMPP داخلی جیتسی، نه دامنه‌ی عمومی.
# با نصب داکری، دامنه‌ی عمومی مال nginx است و prosody هرگز نمی‌بیندش.
JITSI_XMPP_DOMAIN="meet.jitsi"
# مقدار واقعی روی سرور در /home/fardin/music-platform/jitsi/.env با نام
# JWT_APP_SECRET است. اینجا نمی‌آید؛ در .env محلی خودت کپی کن.
# بدون این، `POST /api/bookings/:id/join` خطا می‌دهد — عمداً به درگاه
# جعلی معادلی برنمی‌گردد، چون توکنِ بدون کلید درست فقط یک خطای
# گیج‌کننده در مرورگر کاربر است.
JITSI_APP_SECRET=""

# ---- احراز هویت ----
# با `openssl rand -base64 48` بسازید. حداقل ۳۲ کاراکتر.
# در تولید حتماً مقدار متفاوتی بگذارید.
JWT_SECRET="dev-only-secret-do-not-use-in-production-min-32-chars"

# ---- پیامک ----
# اگر خالی باشد، در حالت توسعه کد ورود در کنسول چاپ می‌شود.
# در محیط تولید خالی بودنش باعث می‌شود برنامه عمداً بالا نیاید.
SMS_API_KEY=""
SMS_OTP_TEMPLATE="verify"

# ---- درگاه پرداخت ----
# اگر خالی باشد، در حالت توسعه درگاه جعلی استفاده می‌شود که هر پرداختی را
# تأیید می‌کند و مستقیم به آدرس بازگشت ریدایرکت می‌کند.
# در محیط تولید خالی بودنش باعث می‌شود برنامه عمداً بالا نیاید.
PAYMENT_MERCHANT_ID=""
# برای تست روی سندباکس زرین‌پال، این را "true" کنید.
PAYMENT_SANDBOX="false"
# آدرس بازگشت باید به **API** اشاره کند نه به فرانت‌اند: تأیید پرداخت
# سرور به سرور انجام می‌شود و فرانت هیچ‌وقت مستقیم با درگاه حرف نمی‌زند.
# API بعد از تأیید، کاربر را به `WEB_ORIGIN/payment/result` می‌فرستد.
PAYMENT_CALLBACK_URL="http://localhost:4000/api/payments/callback"

# ---- فرانت‌اند ----
# مبدأ مجاز CORS و مقصد ریدایرکت پس از پرداخت.
WEB_ORIGIN="http://localhost:3000"

# ---- آبجکت استوریج ----
# اگر این چهارتا کامل نباشند، در حالت توسعه ذخیره‌سازی درون‌حافظه‌ای
# استفاده می‌شود: آپلود و دانلود را خودِ API انجام می‌دهد
# (/api/media/dev/...) تا حلقه‌ی یادگیری بدون حساب ابری قابل اجرا باشد.
# محتوا با هر ری‌استارت می‌پرد. در محیط تولید ناقص بودنشان باعث می‌شود
# برنامه عمداً بالا نیاید.
#
# S3_ENDPOINT میزبان سرویس است، بدون پروتکل. اگر نام باکت در ابتدایش
# نباشد، خودکار به‌عنوان زیردامنه اضافه می‌شود.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ir-thr-at1"
# اگر باکت پشت CDN است، آدرس خواندن با آدرس نوشتن فرق دارد.
S3_PUBLIC_BASE_URL=""
#
# ⚠️ سیاست CORS باکت باید PUT را از WEB_ORIGIN بپذیرد. فایل مستقیم از
# مرورگر می‌رود و بدون آن، مرورگر درخواست را پیش از رسیدن به سرویس رد
# می‌کند — خطایی که هیچ ربطی به امضا ندارد ولی شبیه خطای امضا دیده
# می‌شود.

# ---- آدرس عمومی API ----
# فقط برای ساختن آدرس آپلودِ حالت توسعه لازم است.
API_PUBLIC_URL="http://localhost:4000/api"
