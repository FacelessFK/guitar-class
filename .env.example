# این فایل را به .env کپی کنید. مقادیر پیش‌فرض با docker-compose.yml هماهنگ‌اند.

# ---- دیتابیس ----
DATABASE_URL="postgresql://music:music_dev_password@localhost:5433/music"

# ---- ردیس ----
REDIS_URL="redis://localhost:6380"

# ---- API ----
API_PORT=4000
NODE_ENV=development

# ---- منطقه‌ی زمانی ----
# همه‌ی زمان‌ها در دیتابیس UTC هستند؛ این فقط برای لایه‌ی نمایش و محاسبه‌ی اسلات است.
APP_TIMEZONE="Asia/Tehran"

# ---- جیتسی (فاز بعد) ----
JITSI_DOMAIN=""
JITSI_APP_ID=""
JITSI_APP_SECRET=""

# ---- پیامک (فاز بعد) ----
SMS_API_KEY=""

# ---- درگاه پرداخت (فاز بعد) ----
PAYMENT_MERCHANT_ID=""
PAYMENT_CALLBACK_URL="http://localhost:3000/payment/callback"

# ---- آبجکت استوریج (فاز بعد) ----
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
